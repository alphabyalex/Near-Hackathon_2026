{
  "name": "@wardline/evaluator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:fixtures": "tsx src/cli.ts validate",
    "eval:dev": "tsx src/cli.ts run --split dev",
    "eval:example": "tsx src/cli.ts run --split dev --out evidence/example-run --publish-salt",
    "eval:assessment": "tsx src/cli.ts run --split assessment",
    "commit:assessment": "tsx src/cli.ts commit --split assessment",
    "verify:evidence": "tsx src/cli.ts verify"
  },
  "dependencies": {
    "@wardline/agent": "workspace:*",
    "@wardline/schemas": "workspace:*",
    "@wardline/vault-sim": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
