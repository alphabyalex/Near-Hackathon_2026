# Copy to .env. Never commit .env or any key file.

# Backend API. Read from the shell environment, not from this file, for now.
# The web dev proxy expects port 8787.
API_PORT=8787
# Leave unset for an in-memory database. With mock gateways, state is reseeded on every start either way.
# API_DB_PATH=./data/redline.sqlite

# NEAR (testnet or sandbox only, never mainnet)
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org

# Vault signers file (maps vault accounts to private keys, keep outside repo)
# REDLINE_VAULT_SIGNERS_FILE=~/.redline/testnet/signers.json

# Contract deployment and root keys
# REDLINE_ROOT_ACCOUNT=redline-labs.testnet
# REDLINE_ROOT_KEY=ed25519:...

# Agent binding on vault deployment
# REDLINE_MANIFEST_DIGEST=sha256:...
# REDLINE_ASSESSMENT_REF=...

# NEAR AI Cloud (OpenAI-compatible)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=
