# Copy to .env. Never commit .env or any key file.

# Backend API. Loads this file from the repo root as .env. Values already in the shell win.
# The web dev proxy expects port 8787.
API_PORT=8787
# Leave unset for an in-memory database. With mock gateways, state is reseeded on every start either way.
# API_DB_PATH=./data/redline.sqlite

# NEAR (testnet or sandbox only, never mainnet)
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.near.org

# Vault signers file (maps vault accounts to private keys, keep outside repo)
# REDLINE_VAULT_SIGNERS_FILE=~/.redline/testnet/signers.json

# Contract deployment and root keys
# REDLINE_ROOT_ACCOUNT=redline-labs.testnet
# REDLINE_ROOT_KEY=ed25519:...

# Agent binding on vault deployment
# REDLINE_MANIFEST_DIGEST=sha256:...
# REDLINE_ASSESSMENT_REF=...

# NEAR AI Cloud (OpenAI-compatible)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=

# Agent
REDLINE_ENABLE_COMPROMISED_DEMO=false
REDLINE_AGENT_PROMPT=A
# Exact AI request/response bytes and unverified attestation evidence; ignored by git by default.
# REDLINE_PROOF_DIR=evidence/local-ai-proofs

# Payee API
# stub, or live once @redline/payee-check lands. A mode that cannot be met stops the API.
REDLINE_PAYEE_ENGINE=stub
# memory, or near once PayeeRegistryClient lands.
REDLINE_REGISTRY_MODE=memory
# Set to all to start the memory registry with all 10 seed vendors instead of 4.
# REDLINE_SEED_PAYEES=all
# Receipt signing key: a 32-byte ed25519 seed in hex. Outside production, a missing key is generated into .env.
# REDLINE_ATTESTOR_KEY=
# Free tier per IP per day. Default 200.
# REDLINE_FREE_CALLS_PER_DAY=200
# Set to 1 only behind a proxy that sets X-Forwarded-For.
# REDLINE_TRUST_PROXY=1

# x402 answer for calls over the free tier: 0.01 USDC per call
# Accepting these payments is not built yet. The API answers 402 whatever this is set to.
REDLINE_X402=off
# REDLINE_X402_PAY_TO=0x...
# REDLINE_X402_NETWORK=eip155:84532
# REDLINE_X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Binding. Both default to localhost.
# REDLINE_BIND_PUBLIC=true
# Serve owner routes on their own port instead of /owner.
# REDLINE_OWNER_PORT=8788
# REDLINE_OWNER_BIND_PUBLIC=true

# Owner sign-in. Comma-separated NEAR accounts.
REDLINE_OWNER_ACCOUNTS=
REDLINE_APPROVER_ACCOUNTS=
# on by default. The dashboard has a wallet sign-in, so off is no longer needed locally.
# off still works as an escape hatch, only while owner routes bind to localhost. Approvals need it on.
REDLINE_OWNER_AUTH=on
# REDLINE_SESSION_TTL_MINUTES=30
# Daily limit for each payer API key.
# REDLINE_API_KEY_CALLS_PER_DAY=10000

# Domain the team controls, for a live POST /v1/vendors/verify. Leave empty unless you serve its file.
REDLINE_DEMO_VERIFY_DOMAIN=

# Web app (apps/web). Built into the page, so public values only.
# Public API URL. Unset: the site calls /api on its own origin, and Connect shows a set-your-URL state.
# VITE_REDLINE_API_URL=
# MCP endpoint shown on Connect.
# VITE_REDLINE_MCP_URL=
# Owner routes. Serve them on the same site as the app so the session cookie is sent. Default: <API URL>/owner.
# VITE_REDLINE_OWNER_URL=
# VITE_NEAR_NETWORK=testnet
# Dev server only: where /api is proxied. Default http://127.0.0.1:8787.
# REDLINE_DEV_API=

# MCP server
# REDLINE_API_URL=http://127.0.0.1:8787
# A payer API key, needed to pass payer.
# REDLINE_API_KEY=
# MCP_PORT=8790
# MCP_ALLOWED_HOSTS=
