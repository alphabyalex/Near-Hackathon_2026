{
  "name": "redline",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter \"@redline/api^...\" build && concurrently -n api,web \"pnpm --filter @redline/api dev\" \"pnpm --filter @redline/web dev\"",
    "test": "pnpm -r build && pnpm -r test",
    "eval:dev": "pnpm --filter @redline/evaluator eval:dev",
    "eval:assessment": "pnpm --filter @redline/evaluator eval:assessment",
    "verify:evidence": "pnpm --filter @redline/evaluator verify:evidence",
    "payee:proof": "tsx scripts/make-payee-proof.ts",
    "payee:seed": "tsx scripts/seed-payees.ts",
    "demo:x402-swap": "tsx scripts/demo-x402-swap.ts"
  },
  "devDependencies": {
    "@redline/sdk": "workspace:*",
    "@redline/x402-guard": "workspace:*",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
