{
  "name": "wardline",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter \"@wardline/api^...\" build && concurrently -n api,web \"pnpm --filter @wardline/api dev\" \"pnpm --filter @wardline/web dev\"",
    "test": "node --test tests/brand.test.mjs && pnpm -r build && pnpm -r test",
    "eval:dev": "pnpm --filter @wardline/evaluator eval:dev",
    "eval:assessment": "pnpm --filter @wardline/evaluator eval:assessment",
    "verify:evidence": "pnpm --filter @wardline/evaluator verify:evidence",
    "payee:proof": "tsx scripts/make-payee-proof.ts",
    "payee:seed": "tsx scripts/seed-payees.ts",
    "demo:x402-swap": "tsx scripts/demo-x402-swap.ts",
    "test:brand": "node --test tests/brand.test.mjs",
    "rebrand": "node scripts/rebrand-wardline.mjs",
    "demo:leaked-key": "tsx scripts/demo-leaked-key.ts",
    "demo:providers": "pnpm --filter @wardline/demo-provider start",
    "nearai:record": "tsx scripts/nearai/record.ts",
    "demo:swapped-model": "tsx scripts/demo-swapped-model.ts",
    "demo:plugin": "tsx scripts/demo-plugin.ts",
    "demo:mutual": "tsx scripts/demo-mutual.ts",
    "redteam:numbers": "tsx scripts/redteam-numbers.ts",
    "testnet:mint": "pnpm --filter @wardline/contract-scripts run mint-tokens"
  },
  "devDependencies": {
    "@wardline/demo-provider": "workspace:*",
    "@wardline/sdk": "workspace:*",
    "@wardline/x402-guard": "workspace:*",
    "concurrently": "^9.2.5",
    "openai": "6.10.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
