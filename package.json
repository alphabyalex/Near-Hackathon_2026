{
  "name": "spend-gym",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @spendgym/schemas build && concurrently -n api,web \"pnpm --filter @spendgym/api dev\" \"pnpm --filter @spendgym/web dev\"",
    "test": "pnpm --filter @spendgym/schemas build && pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
